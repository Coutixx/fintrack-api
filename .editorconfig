root = true

# Configurações Globais
[*]
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = false
charset = utf-8

# Arquivos de Configuração, Projetos e JSON
[*.{csproj,fsproj,vbproj,proj,slnx,props,targets,config,nuspec,xml,json}]
indent_size = 2

#### Regras de Código e Formatação para C# ####
[*.cs]
# Diagnósticos
dotnet_diagnostic.IDE0055.severity = warning

# Organização de Usings e Namespace
dotnet_separate_import_directive_groups = true
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:silent
csharp_style_namespace_declarations = file_scoped:warning

# Sintaxes Modernas (.NET / C#)
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# Formatação e Quebras de Linha
csharp_new_line_before_open_brace = methods, properties, types
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

# Nomenclatura para Private Fields (_camelCase)
dotnet_naming_rule.private_fields_should_be__camelcase.severity = suggestion
dotnet_naming_rule.private_fields_should_be__camelcase.symbols = private_fields
dotnet_naming_rule.private_fields_should_be__camelcase.style = _camelcase

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style._camelcase.required_prefix = _
dotnet_naming_style._camelcase.capitalization = camel_case

# Marca usings desnecessários como erro/aviso para remoção fácil
dotnet_diagnostic.IDE0005.severity = warning

# Força a remoção de usings não utilizados
csharp_style_unused_value_expression_statement_preference = discard_variable:silent
